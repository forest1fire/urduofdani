{
  "name": "urduofdani",
  "productName": "UrduOfDani",
  "version": "1.1.8",
  "description": "Modern Urdu word-processor and desktop publishing suite. Like InPage, but built for today.",
  "author": {
    "name": "Muhammad Danish [Dani]",
    "email": "hello.danilabs@gmail.com",
    "url": "https://github.com/forest1fire/urduofdani"
  },
  "license": "MIT",
  "private": true,
  "main": "src/main/index.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on http://localhost:5173 && cross-env UD_DEV=1 electron .\"",
    "dev:web": "vite",
    "build": "vite build && node scripts/copy-assets.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:dir": "electron-builder --dir",
    "engine": "python3 vendor/urduofdani_engine.py",
    "test": "node --test tests/*.test.mjs",
    "audit": "node scripts/audit.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.10",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "concurrently": "^9.1.0",
    "wait-on": "^8.0.1",
    "cross-env": "^7.0.3"
  },
  "build": {
    "appId": "com.danilabs.urduofdani",
    "productName": "UrduOfDani",
    "directories": { "output": "release" },
    "icon": "brands/urduofdani-icon.png",
    "files": [
      "src/main/**/*",
      "src/preload/**/*",
      "dist/**/*",
      "vendor/**/*",
      "brands/**/*",
      "samples/**/*",
      "package.json",
      "LICENSE",
      "README.md",
      "CHANGELOG.md"
    ],
    "extraResources": [
      { "from": "plugins",   "to": "plugins" },
      { "from": "samples",   "to": "samples" },
      { "from": "brands",    "to": "brands" }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "brands/urduofdani-icon.png",
      "artifactName": "UrduOfDani-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true, "createStartMenuShortcut": true,
      "shortcutName": "UrduOfDani"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Office",
      "icon": "brands/urduofdani-icon.png"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.productivity",
      "icon": "brands/urduofdani-icon.png"
    }
  }
}
